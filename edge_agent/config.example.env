# Copy to edge_agent/.env (never commit .env) and fill in.
# optional fallbacks: the camera is chosen in the app (cage page > Cámara); these are used only when
# the app has no camera. IP Webcam on the A12: the address shown on the phone screen
A12_URL=http://192.168.1.50:8080
# optional: a TP-Link Tapo C200 instead of the phone. Its RTSP stream (frames and audio); when set,
# A12_URL is not used. Create a camera account in the Tapo app (Camera settings > Advanced settings >
# Camera account), NOT the TP-Link cloud login, and use that user and password here.
# stream1 = high quality, stream2 = low quality. Needs ffmpeg on PATH; see edge_agent/README.md.
CAMERA_RTSP_URL=
# the AI service behind Caddy (the agent adds /ai/v1/frames and /ai/v1/audio)
AI_URL=https://cuymonitor.duckdns.org
# only for local development (backend and AI service on different ports); empty = the AI_URL host
# BACKEND_URL=
# how often the agent asks the backend for the camera and reports its status (5-300 s)
# CAMERA_POLL_SECONDS=15
# the same API_KEY as the backend and the AI service (infra/.env)
API_KEY=replace-me
# the cage code from the dashboard ("Mis jaulas")
CAGE_ID=cage-1
# 1 or 2 frames per second
FPS=1
AUDIO_ENABLED=true
AUDIO_CLIP_SECONDS=1
REQUEST_TIMEOUT_SECONDS=10
