# Copy to edge_agent/.env (never commit .env) and fill in.
# IP Webcam on the A12: the address shown on the phone screen
A12_URL=http://192.168.1.50:8080
# the AI service behind Caddy (the agent adds /ai/v1/frames and /ai/v1/audio)
AI_URL=https://cuymonitor.duckdns.org
# the same API_KEY as the backend and the AI service (infra/.env)
API_KEY=replace-me
# the cage code from the dashboard ("Mis jaulas")
CAGE_ID=cage-1
# 1 or 2 frames per second
FPS=1
AUDIO_ENABLED=true
AUDIO_CLIP_SECONDS=1
REQUEST_TIMEOUT_SECONDS=10
