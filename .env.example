BACKEND_URL=http://backend:8080
API_KEY=replace-with-a-local-secret
CAGE_ID=cage-1
# every cage this service serves, comma separated; empty = only CAGE_ID
CAGE_IDS=
WINDOW_SECONDS=60
# true = fake events; false = Amazon Bedrock analyses the frames and audio you send
MOCK_MODE=true
# mock mode only: replay a test scenario instead of random events (healthy, lethargic, distress,
# recovery) for the guinea pigs of these mark colours. Empty = random events.
MOCK_SCENARIO=
MOCK_COLORS=RED,BLUE,GREEN,YELLOW
# real mode only. On the EC2 the credentials come from the instance role (no keys here).
AWS_REGION=us-east-1
# Kimi K2.5: the most accurate vision model this account can call (the free plan rules out Anthropic).
BEDROCK_MODEL_ID=moonshotai.kimi-k2.5
WINDOW_MAX_FRAMES=6
# the trained detector (Task 7). Missing file = the service runs without it, /ai/health says so
DETECTOR_PATH=models/detector.onnx
DETECTOR_CONFIDENCE=0.35
# the behavior classifier (Task 10). With it AND the detector, frames go through the trained chain
# (detector -> tracker -> 60 s window -> Random Forest) instead of Bedrock
BEHAVIOR_MODEL_PATH=models/behavior_rf.joblib
# feeder and waterer polygons per cage, fractions of the frame (0-1). Empty = 0 visits
# CAGE_ZONES={"cage-1": {"feeder": [[0.05,0.6],[0.3,0.6],[0.3,0.95],[0.05,0.95]], "waterer": [[0.8,0.05],[0.95,0.05],[0.95,0.3],[0.8,0.3]]}}
CAGE_ZONES=
# optional CSV with the features of every window, to label real windows and retrain
BEHAVIOR_LOG_PATH=
# the trained audio classifier (Task 11): YAMNet in ONNX + SVM/KNN. Without both, the signal rule
YAMNET_PATH=models/yamnet.onnx
AUDIO_MODEL_PATH=models/audio_clf.joblib
