BACKEND_URL=http://backend:8080
API_KEY=replace-with-a-local-secret
CAGE_ID=cage-1
WINDOW_SECONDS=60
# true = fake events; false = Amazon Bedrock analyses the frames and audio you send
MOCK_MODE=true
# real mode only. On the EC2 the credentials come from the instance role (no keys here).
AWS_REGION=us-east-1
# Amazon Nova needs no extra form. Claude models work after Anthropic's use-case form is filled in.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
WINDOW_MAX_FRAMES=6
